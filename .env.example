# Names only. Never put a real value in this file or commit one.
#
# PRORACLE reads credentials from the process environment and does not load .env files itself.
# If you keep a local file, keep it untracked (the repository ignores .env) and load it into
# your own shell or scheduler. Never share it, paste it into an issue, or attach it to a pull request.
# See docs/OPERATIONS.md for what each variable is used for.

# Your own provider key (fixture and final-result source)
BSD_API_TOKEN=

# Your own Supabase project. The service key is a server-side secret that bypasses row-level
# security: never in browser code, never in a contributor workflow.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PRORACLE_DB_SCHEMA=proracle
# Optional fetch windows for the self-hosted runner (defaults shown; see docs/OPERATIONS.md)
# PRORACLE_LOOKAHEAD_DAYS=2
# PRORACLE_HISTORY_DAYS=30

# Optional: your own Telegram bot and chat, for the report sender
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
